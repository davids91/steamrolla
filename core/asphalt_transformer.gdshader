shader_type canvas_item;

uniform sampler2D terrain;
uniform sampler2D asphalt; // Basically asphalt quantity
uniform sampler2D asphalt_delta; // the asphalt delta generated by the updater
uniform sampler2D target_height; // the reference height set by the level
uniform float set_to_reference: hint_range(0.0, 1.0) = 0.; // Set to some arbitrary value to "snap" asphalt to given reference

void fragment() {
	float asphalt_level = texture(asphalt, UV).r + (texture(asphalt_delta, UV).r - 0.5) * 2.;
	float expected_asphalt_level = (texture(target_height, UV).r - texture(terrain, UV).r * 0.5) * 2.0;
	asphalt_level = mix(asphalt_level, expected_asphalt_level, set_to_reference);
	asphalt_level = clamp(asphalt_level, 0., 1.);
	COLOR = vec4(vec3(asphalt_level), 1.);
}
