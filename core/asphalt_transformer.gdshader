shader_type canvas_item;

uniform sampler2D asphalt_state; // Basically asphalt quantity
uniform sampler2D asphalt_delta; // the asphalt delta generated by the updater
uniform sampler2D target_asphalt_state; /// r: quantity
uniform float set_to_reference: hint_range(0.0, 1.0) = 0.; // Set to some arbitrary value to "snap" asphalt to given reference

void fragment() {
	float asphalt_level = texture(asphalt_state, UV).r + (texture(asphalt_delta, UV).r - 0.5) * 2.;
	asphalt_level = mix(asphalt_level, texture(target_asphalt_state, UV).r, set_to_reference);
	asphalt_level = clamp(asphalt_level, 0., 1.);
	COLOR = vec4(vec3(asphalt_level), 1.);
}
